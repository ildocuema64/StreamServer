# Copy to backend/.env OR use `.env` at the repo root (root is loaded first, then this file overrides).
# See root `.env.example` for the full quick-start template.
NODE_ENV=development

# Dev without local Redis / Icecast (API + Supabase only):
# REDIS_DISABLED=true
# ICECAST_DISABLED=true

# --- Supabase (recomendado: sem Docker local para a BD) ---
# No dashboard: Project Settings → Database → Connection string → URI
# Use "Session mode" ou ligação direta (porta 5432) para este servidor Node de longa duração.
# Cola a URI aqui; comenta as variáveis POSTGRES_* abaixo ou deixa-as — DATABASE_URL tem prioridade.
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-....pooler.supabase.com:5432/postgres
# DATABASE_SSL=false   # só se precisares de desligar SSL (raro)

# --- Supabase API (opcional: REST + @supabase/supabase-js no dashboard ou outro cliente) ---
# Project Settings → API: copia "Project URL" e "anon" / "public"
# A anon key é pensada para o browser com Row Level Security (RLS) ligado.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=   # só em servidor, se precisares ignorar RLS; nunca no frontend

# --- Postgres local / Docker (ignorado se DATABASE_URL estiver definido) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamserver
POSTGRES_USER=streamadmin
POSTGRES_PASSWORD=devpassword

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devredis

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Icecast / Liquidsoap (for API health & stream routes)
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=adminpass

LIQUIDSOAP_TELNET_HOST=localhost
LIQUIDSOAP_TELNET_PORT=1234

MEDIA_STORAGE_PATH=/tmp/streamserver-media
RECORDINGS_PATH=/tmp/streamserver-recordings
