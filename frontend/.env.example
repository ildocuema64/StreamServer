# Copiar para frontend/.env – usado pelo Vite em dev

# Local: proxy Vite para o backend (pode omitir se usares o default 127.0.0.1:3000)
# VITE_BACKEND_URL=http://127.0.0.1:3000

# Vercel (obrigatório para login/API): URL pública do backend (Render, Railway, Fly, etc.)
# Settings → Environment Variables → Production + Preview
# VITE_BACKEND_URL=https://streamserver-api.onrender.com
# No backend, define APP_URL=https://o-teu-app.vercel.app (CORS)

# Supabase no browser (opcional – @supabase/supabase-js)
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
